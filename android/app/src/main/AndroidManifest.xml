<?xml version="1.0" encoding="utf-8"?>
<!--
  Puck -- Android manifest.

  Every permission below exists because a specific gesture needs it. Nothing
  is requested at install time beyond what the platform surfaces from these
  declarations, and Puck re-requests the dangerous ones lazily, at the moment
  they are actually used.

  Notably absent: SYSTEM_ALERT_WINDOW. Puck is an in-app surface by design
  (iOS has no equivalent, and the draw-over-apps prompt is a conversion
  killer). See README "Why not a system-wide overlay" for the full reasoning.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Swipe-up intent bar + weather: HTTPS only, no cleartext. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Long-press SOS: a vibration pattern the user can feel through a coat. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Single tap: read the next calendar event. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!--
      Long-press SOS: flashlight.
      The camera permission is required by the Camera2 API, which is the only
      supported way to drive the torch. Puck never opens a camera preview and
      never stores an image.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Long-press SOS (fresh fix) and single tap (cached fix, for weather). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Swipe-up intent bar: the microphone button. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- All optional: Puck degrades instead of refusing to install. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <!--
      Android 11+ package visibility: required so Puck can see that an SMS
      app exists before deep-linking into it with a pre-filled body.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:name="${applicationName}"
        android:label="Puck"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/LaunchTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data android:name="flutterEmbedding" android:value="2" />
    </application>
</manifest>
